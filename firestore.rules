rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'sdSOSdUT2ASQOt7mp3d8egvD6Um2';
    }
    function text(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    match /providers/{uid} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['ownerUid','name','rubro','description','services','whatsapp','facebook','website','instagram','tiktok','photos','createdAt','status'])
        && request.resource.data.rubro in ['Animación y Entretenimiento','Autos y Traslados','Ceremonias Simbólicas','Diseño y Ambientación','Gastronomía y Vitivinicultura','Infraestructura y Locaciones','Moda, Estética y Joyería Fina','Producción Técnica y Audio','Registro Audiovisual']
        && request.resource.data.ownerUid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.description, 1, 3000)
        && text(request.resource.data.services, 1, 3000)
        && text(request.resource.data.whatsapp, 0, 500)
        && text(request.resource.data.facebook, 0, 500)
        && text(request.resource.data.website, 0, 500)
        && text(request.resource.data.instagram, 0, 500)
        && text(request.resource.data.tiktok, 0, 500)
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && request.resource.data.photos.toSet().size() == request.resource.data.photos.size();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'reviewed';
      allow delete: if false;
    }
  }
}
