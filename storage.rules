rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'REEMPLAZAR_UID_ADMIN';
    }
    function canUpload(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && !firestore.exists(/databases/(default)/documents/providers/$(uid));
    }
    match /providers/{uid}/{slot} {
      allow read: if isAdmin();
      // Ten fixed slots: a client cannot bypass the maximum by changing filenames.
      allow create, update: if canUpload(uid) && slot.matches('^[0-9]$')
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Permit rollback of incomplete submissions only.
      allow delete: if canUpload(uid) && slot.matches('^[0-9]$');
    }
  }
}
